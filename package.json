{
  "name": "ascii-delve",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ASCII Delve: a sci-fi squad of AI marines clears procedurally generated sectors. Forked from ascii_tournament.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "arena": "tsx src/cli/arena.ts",
    "delve": "tsx src/cli/delve.ts",
    "smoke": "vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "rot-js": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^26.6.2",
    "eslint": "^9.12.0",
    "playwright-core": "^1.56.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
